{
  "name": "@local/studio-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Studio: a warm desktop chat theme with original icons and a focused workspace layout. Opt-in only.",
  "license": "MIT",
  "engines": { "dsh": "0.2.2-rc.1" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "CHANGELOG.md", "LICENSE", "src", "tests", "build.mjs", ".npmrc", "pnpm-lock.yaml", "pnpm-workspace.yaml"],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-isolation=none tests/controller.test.js tests/package.test.js"
  },
  "dependencies": { "@deepseek-ai/schemastery": "~3.19.0" },
  "devDependencies": { "esbuild": "0.28.2" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
