{
  "name": "@local/codex-usage",
  "version": "1.1.0",
  "private": true,
  "description": "Clickable sidebar usage indicator for the installed OpenAI Codex sign-in provider.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["dsh-openai-codex-auth", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
